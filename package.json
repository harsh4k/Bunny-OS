{
  "name": "bunny-os",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --port 1420",
    "build": "tauri build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "cross-env E2E=1 npm run build:frontend",
    "check:version": "node scripts/check-version.mjs",
    "verify:beta": "pwsh -File scripts/verify-beta.ps1",
    "package:sidecar": "pwsh -File scripts/package-sidecar.ps1",
    "diagnostics": "pwsh -File scripts/export-diagnostics.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "cross-env": "^7.0.3",
    "playwright": "^1.49.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^2"
  }
}
